# Modo de teste (Playwright e build:test). Determinístico: sem falhas aleatórias,
# latência fixa baixa e banco do mock recriado a partir do seed a cada início.
# Os cenários são escolhidos pelos testes via localStorage['kurio:mock:scenarios'] (decisão A6).
# Demais variáveis herdam do .env.
VITE_MOCK_LATENCY_MIN_MS=50
VITE_MOCK_LATENCY_MAX_MS=50
VITE_MOCK_ERROR_RATE=0
VITE_MOCK_NETWORK_ERROR_RATE=0
VITE_MOCK_PAYMENT_DECLINE_RATE=0
VITE_MOCK_SEED_RESET=true
VITE_MOCK_SCENARIOS=
