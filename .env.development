# Ajustes do dia a dia para o modo de desenvolvimento (npm run dev).
# Sobrescreve o .env. Para forçar erros, edite VITE_MOCK_ERROR_RATE (0 a 1) ou
# VITE_MOCK_NETWORK_ERROR_RATE, ou use VITE_MOCK_SCENARIOS (ex.: server-error:GET /nfts),
# ou grave localStorage['kurio:mock:scenarios'] no navegador, que tem prioridade (decisão A6).
VITE_MOCK_LATENCY_MIN_MS=200
VITE_MOCK_LATENCY_MAX_MS=1200
VITE_MOCK_ERROR_RATE=0
VITE_MOCK_NETWORK_ERROR_RATE=0
VITE_MOCK_SCENARIOS=
VITE_MOCK_SEED_RESET=false
