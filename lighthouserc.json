{
  "ci": {
    "collect": {
      "startServerCommand": "npm run build:test && npm run preview -- --port 4174 --strictPort",
      "startServerReadyPattern": "Local",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/nft/emerald-ape-042",
        "http://localhost:4174/carrinho",
        "http://localhost:4174/entrar",
        "http://localhost:4174/pagamento",
        "http://localhost:4174/perfil/dados"
      ],
      "numberOfRuns": 3,
      "puppeteerScript": "./lighthouse-login.cjs",
      "settings": {
        "disableStorageReset": true
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
